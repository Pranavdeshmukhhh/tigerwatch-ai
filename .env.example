# VisualWatch v8: private glass dashboard, budgeted automation and review feedback.
# Public/local: python main.py --setup-public. Official Meta: python main.py --setup.
FREE_TIER_ONLY=true
# Confirm Gemini billing is disabled and Supabase is Free before enabling live calls.
# Code cannot inspect your external billing plans from these API keys.
FREE_PLANS_CONFIRMED=false

# meta = official approved API. browser = normal logged-out public profiles only.
SOURCE_KIND=meta
# general, sale_review or wildlife_sales. Sale findings require private human review.
MONITOR_MODE=general
ALERTS_ENABLED=true
# Optional one-attempt-per-UTC-day private health digest; consumes the shared alert budget.
SEND_DAILY_DIGEST=false
BROWSER_MAX_POSTS=200
BROWSER_MAX_SCROLLS=60
BROWSER_SCROLL_SECONDS=3
BROWSER_HEADLESS=true
# Local URL-only reference intake (never fetches media or submits reports).
CASE_DB_PATH=review-cases.sqlite3

# Use a description OR an array of simultaneous targets; no category selection needed.
# Examples: Pikachu; a person wearing a blue shirt; a red car; a sign with the text STOP.
# Omit both to preserve the original living-tiger photograph target.
TARGET_DESCRIPTION=
TARGETS_JSON=
# Example: [{"description":"Pikachu","threshold":0.8},{"description":"a red car","threshold":0.9}]
# For natural-language targets the model follows your description; true forces photos.
TARGET_KIND=
REQUIRE_PHOTOGRAPH=
MATCH_THRESHOLD=0.85

# Official Instagram API WITH FACEBOOK LOGIN. No passwords or session cookies.
# Facebook USER access token; see docs/API_VERIFICATION.md for endpoint permissions.
META_ACCESS_TOKEN=REPLACE_ME
IG_USER_ID=REPLACE_ME
GRAPH_API_VERSION=v26.0
# Optional, used for Meta appsecret_proof if your app requires it.
META_APP_SECRET=
HASHTAGS=tiger
ACCOUNTS=

GEMINI_API_KEY=REPLACE_ME
# auto routes simple images to 3.5 Flash-Lite and complex/OCR/video to 3.8 Flash.
# All selected models must remain on Google's Free plan; no quota/billing bypass.
GEMINI_MODEL=auto
# Confirm you may submit selected photos to Gemini under current provider terms.
# Free-tier content can improve Google products. Read the README first.
AI_ANALYSIS_RIGHTS_CONFIRMED=false
# TIGER_CONFIDENCE is still accepted as a legacy alias if MATCH_THRESHOLD is unset.
REVIEW_SCORE=0.65

TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
# Private chat/group recommended. Link previews are always disabled.
SEND_PHOTO=false
PHOTO_RESHARE_RIGHTS_CONFIRMED=false
# Exact @accounts with documented account-wide permission (no broad #hashtag grants).
PHOTO_RESHARE_SOURCES=
# Or exact Instagram post IDs with individual re-sharing permission.
PHOTO_RESHARE_MEDIA_IDS=

# Application caps, not provider quotas or currency spending limits. Zero disables usage.
# Attempts/reservations count even when a request fails or a worker crashes.
MAX_AI_CALLS_PER_RUN=4
MAX_AI_CALLS_PER_DAY=20
AI_MIN_INTERVAL_SECONDS=6
MAX_ALERTS_PER_RUN=3
MAX_ALERTS_PER_DAY=10
ALERT_MIN_INTERVAL_SECONDS=4
MAX_POSTS_PER_SOURCE=30
MAX_PAGES_PER_SOURCE=3
MAX_META_CALLS_PER_RUN=80
MAX_CAROUSEL_IMAGES=20
MAX_POST_AGE_HOURS=24
MAX_QUEUE_ITEMS_PER_RUN=60
MAX_QUEUE_AGE_HOURS=72
MAX_RETRY_ATTEMPTS=6
RETRY_BASE_SECONDS=300
DEDUP_RETENTION_DAYS=90

# Supabase required in Actions; SQLite if BOTH values are blank locally.
# Use a legacy service_role JWT, never an anon/publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SQLITE_PATH=tigerwatch.sqlite3
